# Database Connection String for Prisma (PostgreSQL)
# For local Docker setup: "postgresql://myuser:mypassword@db:5432/kanban_db?schema=public"
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"

# JWT Token Cryptographic Secret Key (Used to verify authorization session cookies)
JWT_SECRET="replace-with-a-secure-random-64-character-secret-key"

# Application Environment Mode (production / development)
NODE_ENV="development"
